{
  "name": "deemix-app",
  "version": "2.6.2",
  "description": "Modern Deezer music downloader",
  "author": {
    "name": "Team MAXIMUS",
    "email": "noreply@deemix.app"
  },
  "homepage": "https://deemix.app",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist dist-electron && vite build && electron-builder",
    "build:vite": "rm -rf dist dist-electron && vite build",
    "build:mac": "rm -rf dist dist-electron && vite build && electron-builder --mac --universal",
    "build:win": "rm -rf dist dist-electron && vite build && electron-builder --win --x64",
    "build:win-arm64": "rm -rf dist dist-electron && vite build && electron-builder --win --arm64",
    "build:linux": "rm -rf dist dist-electron && vite build && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --x64",
    "build:linux-arm64": "rm -rf dist dist-electron && vite build && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --arm64",
    "build:mac-arm64": "rm -rf dist dist-electron && vite build && electron-builder --mac --arm64",
    "build:all": "rm -rf dist dist-electron && vite build && electron-builder --mac --universal && electron-builder --mac --arm64 && electron-builder --win --x64 && electron-builder --win --arm64 && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --x64 && PATH=\"$PWD/scripts/build-tools:$PATH\" electron-builder --linux --arm64",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\""
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@vue/devtools-api": "^8.1.5",
    "egoroof-blowfish": "^4.0.3",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "@xmldom/xmldom": "^0.8.13",
    "ip-address": "^10.4.0",
    "follow-redirects": "^1.16.0",
    "engine.io-client": "^6.6.5",
    "tar": "^7.5.21",
    "form-data": "^4.0.6",
    "tmp": "^0.2.6",
    "js-yaml": "^4.3.1",
    "postcss": "$postcss"
  },
  "build": {
    "appId": "app.deemix.remastered",
    "productName": "Deemix Remastered",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns",
      "identity": "-",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Audio"
    }
  }
}
